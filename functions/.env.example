# TTS provider: google | elevenlabs
TTS_PROVIDER=google

# Google Cloud Text-to-Speech uses Application Default Credentials.
# Set GOOGLE_APPLICATION_CREDENTIALS to a service account JSON path (local) or configure ADC in Cloud Functions environment.

# Optional: per-voice Google TTS voice names (JSON map)
# GOOGLE_TTS_VOICE_NAMES={"en-female":"en-US-Standard-C","en-male":"en-US-Standard-D","uz-female":"uz-UZ-Standard-A","uz-male":"uz-UZ-Standard-A"}

# ElevenLabs (if TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_EN_FEMALE=
ELEVENLABS_VOICE_EN_MALE=
ELEVENLABS_VOICE_UZ_FEMALE=
ELEVENLABS_VOICE_UZ_MALE=